root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
indent_style = space
indent_size = 4

[*.psm1]
indent_style = space
indent_size = 4

[*.psd1]
indent_style = space
indent_size = 4

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.yml]
end_of_line = lf
indent_style = space
indent_size = 2

[*.yaml]
end_of_line = lf
indent_style = space
indent_size = 2
